# ==========================================
# PRODUCTION ENVIRONMENT CONFIGURATION
# ==========================================

APP_NAME="Yadav Interior"
APP_ENV=production
APP_KEY=base64:GENERATE_VIA_ARTISAN_KEY_GENERATE
APP_DEBUG=false
APP_TIMEZONE=UTC
APP_URL=https://your-domain.onrender.com

# ------------------------------------------
# LOGGING
# ------------------------------------------
# On Render / Vercel, stderr ensures logs show in web dashboard
LOG_CHANNEL=stderr
LOG_LEVEL=info

# ------------------------------------------
# DATABASE CONFIGURATION
# ------------------------------------------
# Option A: PostgreSQL (Render Managed DB / Neon / Supabase)
DB_CONNECTION=pgsql
# You can supply DATABASE_URL directly:
# DATABASE_URL=postgres://user:password@host:port/database

# Option B: MySQL (PlanetScale / Aiven / Clever Cloud)
# DB_CONNECTION=mysql
# DB_HOST=your-mysql-host
# DB_PORT=3306
# DB_DATABASE=interior_db
# DB_USERNAME=your-username
# DB_PASSWORD=your-password

# Option C: SQLite (Single instance Render / local test)
# DB_CONNECTION=sqlite

# ------------------------------------------
# SESSION & CACHE
# ------------------------------------------
# Use database, redis, or cookie for serverless (Vercel) & cloud (Render)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

CACHE_STORE=database
CACHE_PREFIX=interior_

QUEUE_CONNECTION=database

# ------------------------------------------
# BROADCASTING & REVERB
# ------------------------------------------
BROADCAST_CONNECTION=log

# ------------------------------------------
# MAIL CONFIGURATION (SMTP / Resend / Mailgun)
# ------------------------------------------
MAIL_MAILER=log
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@yadavinterior.com"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------
# CLOUD STORAGE (AWS S3 / Cloudflare R2)
# ------------------------------------------
FILESYSTEM_DISK=public
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=us-east-1
# AWS_BUCKET=
# AWS_URL=

# ------------------------------------------
# CORS CONFIGURATION
# ------------------------------------------
CORS_ALLOWED_ORIGINS="*"

# ------------------------------------------
# AUTOMATION (Render Entrypoint)
# ------------------------------------------
AUTO_MIGRATE=true
DB_SEED=false
